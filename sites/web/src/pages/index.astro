---
import Base from '../layouts/Base.astro';
---
<Base
  title="NorWealth — verktøy for sparing og investering"
  beskrivelse="Gratis kalkulatorer som viser hva sparingen din blir til, og verktøy som følger deg videre når du vil ha mer kontroll."
>
  <main style="max-width: 1240px; margin: 0 auto; padding: var(--nw-space-8) var(--nw-space-7);">
    <h1 class="nw-display-l" style="margin: 0; max-width: 16ch; color: var(--nw-brand-500);">
      Grunnmuren står.
    </h1>
    <p class="nw-body-l" style="margin: var(--nw-space-6) 0 0; max-width: 44ch; color: var(--nw-ink-200);">
      Dette er Astro-siden. Alt du ser her er ferdig HTML før JavaScript kjører —
      det er hele poenget med denne halvdelen.
    </p>

    <div style="display: flex; gap: var(--nw-space-4); margin-top: var(--nw-space-6);">
      <span style="width: 64px; height: 56px; border-radius: var(--nw-radius-md); background: var(--nw-brand-600);"></span>
      <span style="width: 64px; height: 56px; border-radius: var(--nw-radius-md); background: var(--nw-brand-500);"></span>
      <span style="width: 64px; height: 56px; border-radius: var(--nw-radius-md); background: var(--nw-brand-400);"></span>
      <span style="width: 64px; height: 56px; border-radius: var(--nw-radius-md); background: var(--nw-accent-700);"></span>
      <span style="width: 64px; height: 56px; border-radius: var(--nw-radius-md); background: var(--nw-accent-500);"></span>
    </div>
    <p class="nw-caption" style="margin: var(--nw-space-3) 0 0; color: var(--nw-ink-300);">
      Fargene kommer fra packages/core/tokens.css. Ser de riktige ut, virker den delte pakken.
    </p>
  </main>
</Base>
